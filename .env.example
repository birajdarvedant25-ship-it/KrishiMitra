# KrishiMitra Environment Configuration

# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# JWT Secret for Session Authentication
JWT_SECRET=replace_with_a_random_secret

# AI Operational Mode: 'mock' (default for instant development/testing without keys) or 'production'
AI_MODE=mock

# Google Gemini API Key (Multimodal Crop Disease Identification & Advisory)
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here

# OpenAI API Key (Secondary verification and fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Weather API Key (Optional: OpenWeatherMap. If not provided, Open-Meteo free live API is used automatically)
WEATHER_API_KEY=

# Database File Path (SQLite)
DATABASE_PATH=./krishimitra.db
