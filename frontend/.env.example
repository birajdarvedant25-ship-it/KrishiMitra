# KrishiMitra Frontend Environment Configuration

# For production deployment on Vercel:
# Leave VITE_API_URL empty so the frontend automatically uses the relative '/api' route on the same domain
VITE_API_URL=

# For local browser development:
# VITE_API_URL=http://localhost:5000

# For Android development and LAN mobile testing (your Wi-Fi IP):
# VITE_API_URL=http://192.168.1.23:5000
