{
  "name": "krishimitra-backend",
  "version": "1.0.0",
  "description": "Backend API for KrishiMitra AI Farming Assistant",
  "main": "app.mjs",
  "exports": {
    ".": "./app.mjs"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && esbuild src/app.ts --bundle --platform=node --format=esm --packages=external --outfile=app.mjs && esbuild src/app.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/app.mjs",
    "vercel-build": "npm run build",
    "start": "node dist/server.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.86.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.5",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
